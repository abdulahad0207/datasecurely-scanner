{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "description": "Unified Normalized Finding Schema across all security scanners",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "scan_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_tool": {
      "type": "string",
      "enum": ["custom_headers", "custom_tls", "custom_cookies", "custom_files", "httpx", "subfinder", "nuclei", "nmap"]
    },
    "template_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "host": {
      "type": "string"
    },
    "evidence": {
      "type": "string",
      "maxLength": 2048
    },
    "raw_ref": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string",
      "description": "SHA256 hash of template_id + host + normalized path"
    },
    "ai_json": {
      "type": ["object", "null"],
      "properties": {
        "plain_summary": { "type": "string" },
        "business_impact": { "type": "string" },
        "fix_steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "effort": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    }
  },
  "required": ["source_tool", "template_id", "title", "severity", "host", "fingerprint"]
}
