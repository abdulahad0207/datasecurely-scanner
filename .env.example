# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=your-secret-key-min-32-chars-here
# Development token bypass (Local testing only. NEVER set to true in staging or production)
ENABLE_DEV_TOKEN_BYPASS=false

# Backend & Worker Network
API_HOST=0.0.0.0
API_PORT=8000
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

# Redis & Task Queue
REDIS_URL=redis://redis:6379/0

# Supabase (Auth + Database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Google Gemini API (AI Triage & Bilingual Reports)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Email Delivery (Resend or Brevo)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=alerts@yourdomain.com

# Monitoring & Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ENVIRONMENT=development

# Storage / Artifacts
REPORT_STORAGE_PATH=./storage/reports
